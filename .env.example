# ============================================
# HERMAN SCOUT - Environment Variables
# ============================================

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Google Maps API (Demo Key - free tier)
GOOGLE_MAPS_API_KEY=

# Google Gemini AI (free tier - 1500 req/day)
GEMINI_API_KEY=

# Brevo Email API (free tier - 300/day)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=infothermansoftware@gmail.com
BREVO_SENDER_NAME=HERMAN Software Solutions

# ============================================
# WATER TANK CONFIG
# ============================================
MAX_PER_SCAN=100
DAILY_BATCH=20
BUFFER_THRESHOLD=20
MIN_SCORE=60

# Send days: 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 0=Sun
SEND_DAYS=1,3,5

# Rate limiting
CRAWL_DELAY_MS=1000
EMAIL_DELAY_MS=3000